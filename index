<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mihin Weragama | Elite Victories Portfolio</title>
    <!-- Google Fonts for Professional Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #05050f;
            --neon-blue: #3b82f6;
            --neon-purple: #9333ea;
            --neon-gold: #fbbf24;
            --gold-glow: #f59e0b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-deep);
            color: #f3f4f6;
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Glossy Blue-Purple Gradient & Neon Chess Board Background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: 
                /* Subtle chess board pattern overlay */
                linear-gradient(45deg, rgba(59, 130, 246, 0.03) 25%, transparent 25%), 
                linear-gradient(-45deg, rgba(59, 130, 246, 0.03) 25%, transparent 25%), 
                linear-gradient(45deg, transparent 75%, rgba(147, 51, 234, 0.03) 75%), 
                linear-gradient(-45deg, transparent 75%, rgba(147, 51, 234, 0.03) 75%),
                /* Deep Glossy Multi-stop Gradient */
                radial-gradient(circle at 15% 20%, rgba(59, 130, 246, 0.18) 0%, transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(147, 51, 234, 0.18) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(15, 23, 42, 0.95) 0%, #030308 100%);
            background-size: 60px 60px, 60px 60px, 60px 60px, 60px 60px, 100% 100%, 100% 100%, 100% 100%;
            z-index: -2;
        }

        /* Glassmorphism Glossy Overlays */
        .glass-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(circle at center, rgba(255, 255, 255, 0.01) 0%, rgba(0, 0, 0, 0.4) 100%);
            pointer-events: none;
            z-index: -1;
        }

        header {
            text-align: center;
            padding: 80px 20px 40px;
            max-width: 900px;
            margin: 0 auto;
        }

        /* Glowing Neon + Gold Shade Headlines */
        h1, h2 {
            font-family: 'Cinzel', serif;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        h1 {
            font-size: clamp(2.5rem, 5vw, 4.2rem);
            font-weight: 900;
            background: linear-gradient(135deg, #fff 20%, var(--neon-gold) 60%, var(--gold-glow) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 35px rgba(251, 191, 36, 0.3), 0 0 70px rgba(59, 130, 246, 0.2);
            margin-bottom: 15px;
        }

        .subtitle {
            font-size: 1.15rem;
            color: #93c5fd;
            text-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
            font-weight: 500;
            letter-spacing: 1px;
        }

        /* Container for Content Sections */
        .container {
            max-width: 1100px;
            margin: 0 auto 80px;
            padding: 0 20px;
        }

        .section-title {
            font-size: 2rem;
            color: #fff;
            margin-bottom: 30px;
            text-align: center;
            background: linear-gradient(135deg, #fff 30%, var(--neon-blue) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 25px rgba(59, 130, 246, 0.4);
        }

        /* Glossy Cards for Victories */
        .victories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
        }

        .victory-card {
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(59, 130, 246, 0.25);
            border-radius: 16px;
            padding: 30px;
            backdrop-filter: blur(12px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .victory-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--neon-blue), var(--neon-purple), var(--neon-gold));
        }

        .victory-card:hover {
            transform: translateY(-5px);
            border-color: rgba(251, 191, 36, 0.5);
            box-shadow: 0 20px 40px rgba(59, 130, 246, 0.2), 0 0 25px rgba(251, 191, 36, 0.15);
        }

        .opponent-name {
            font-size: 1.5rem;
            font-family: 'Cinzel', serif;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .title-badge {
            background: linear-gradient(135deg, var(--neon-gold), var(--gold-glow));
            color: #000;
            font-size: 0.75rem;
            font-weight: 900;
            padding: 3px 8px;
            border-radius: 6px;
            box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
        }

        .match-details {
            font-size: 0.95rem;
            color: #cbd5e1;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .match-details span {
            color: var(--neon-blue);
            font-weight: 600;
        }

        /* Action Buttons with Neon Glow */
        .btn-glow {
            display: inline-block;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(147, 51, 234, 0.2));
            border: 1px solid var(--neon-blue);
            color: #fff;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.2);
        }

        .btn-glow:hover {
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple));
            box-shadow: 0 0 20px var(--neon-blue), 0 0 35px var(--neon-purple);
            color: #fff;
        }

        footer {
            text-align: center;
            padding: 40px;
            color: #64748b;
            font-size: 0.9rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body>
    <div class="glass-overlay"></div>

    <header>
        <h1>Hall of Titled Victories</h1>
        <p class="subtitle">Showcasing Master-Level Battles & Over-the-Board / Online Triumphs</p>
    </header>

    <div class="container">
        <h2 class="section-title">Featured Grandmaster Scalps</h2>
        
        <div class="victories-grid">
            <!-- Victory 1 -->
            <div class="victory-card">
                <div class="opponent-name">
                    GM Joseph Gallagher
                    <span class="title-badge">GM</span>
                </div>
                <div class="match-details">
                    <span>Format:</span> Online Bullet Arena<br>
                    <span>Date:</span> August 1, 2026<br>
                    <span>Highlight:</span> Clinical tactical conversion under severe time pressure.
                </div>
                <a href="#" class="btn-glow">View PGN / Game Analysis</a>
            </div>

            <!-- Victory 2 -->
            <div class="victory-card">
                <div class="opponent-name">
                    GM Davor Rogić
                    <span class="title-badge">GM</span>
                </div>
                <div class="match-details">
                    <span>Format:</span> Online Bullet Match<br>
                    <span>Date:</span> August 1, 2026<br>
                    <span>Highlight:</span> Dynamic attacking masterpiece in high-speed play.
                </div>
                <a href="#" class="btn-glow">View PGN / Game Analysis</a>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 Mihin Weragama. Designed for Elite Chess Excellence.</p>
    </body>
</html>
